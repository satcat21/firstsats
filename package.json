{
    "name": "arkade-firstsats",
    "version": "0.1.0",
    "description": "A beginner-friendly reference application for the Arkade TypeScript SDK: create a wallet, receive and send VTXOs, and see exactly what the protocol does at every step.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=24.20.0 <27",
        "npm": ">=10"
    },
    "bin": {
        "firstsats": "./bin/firstsats.js"
    },
    "main": "./src/index.ts",
    "files": [
        "src",
        "bin",
        "docs",
        "README.md"
    ],
    "keywords": [
        "arkade",
        "ark",
        "bitcoin",
        "vtxo",
        "wallet",
        "example",
        "reference"
    ],
    "scripts": {
        "firstsats": "tsx src/cli/index.ts",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "web:typecheck": "npm --prefix apps/web exec -- tsc -p apps/web/tsconfig.app.json --noEmit",
        "test": "vitest run --exclude \"test/e2e/**\"",
        "test:ci": "vitest run --exclude \"test/e2e/**\" --reporter=default --reporter=junit --outputFile=reports/junit.xml",
        "test:watch": "vitest",
        "test:e2e": "vitest run test/e2e",
        "audit": "npm audit --audit-level=high --omit=dev",
        "verify": "npm run lint && npm run typecheck && npm run web:typecheck && npm test && npm run audit",
        "web": "node apps/web/scripts/serve.mjs",
        "web:build": "npm --prefix apps/web run build",
        "web:build:pages": "npm --prefix apps/web run build -- --base-href /firstsats/",
        "web:install": "npm --prefix apps/web ci",
        "verify:all": "npm run verify && npm run web:build"
    },
    "dependencies": {
        "@arkade-os/sdk": "^0.4.67",
        "@scure/bip39": "^2.4.0",
        "eventsource": "^5.1.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "@types/node": "^26.4.0",
        "tslib": "^2.8.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "packageManager": "npm@12.0.2",
    "allowScripts": {
        "esbuild": false
    }
}
