# All settings are optional — the defaults point at the public Arkade signet
# deployment, which is live and free to use.

# Which network preset to use: signet | mutinynet | regtest
FIRSTSATS_NETWORK=signet

# Override the Arkade server / Esplora endpoints for the chosen network.
# FIRSTSATS_ARK_SERVER_URL=https://signet.arkade.sh
# FIRSTSATS_ESPLORA_URL=https://mempool.signet.arkade.sh/api

# Where wallet keystores are written. Defaults to ./.firstsats
# FIRSTSATS_DATA_DIR=./.firstsats

# Set to 1 to run the end-to-end suite against the live signet deployment.
# FIRSTSATS_E2E=1
